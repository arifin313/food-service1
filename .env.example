# start.bat copies this to .env automatically. Change the passwords if you like.
GATEWAY_PORT=9090
TEMP_DB_USER=foodsafe
TEMP_DB_PASSWORD=change-me-temp
FOOD_DB_USER=foodsafe
FOOD_DB_PASSWORD=change-me-food

# true = fill empty databases with demo readings/food items on first start
SEED_DEMO_DATA=true
# alert if a storage unit has not been checked for this many hours
STALE_READING_HOURS=24
